<Application x:Class="POS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:POS.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>
                <ResourceDictionary Source="Themes/Tokens.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
                <ResourceDictionary Source="Resources/Langs/en.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
            <converters:InverseBooleanConverter x:Key="InverseBool" />
            <converters:CurrencyFormatConverter x:Key="CurrencyConv" />
            <converters:NameToInitialConverter x:Key="InitialConv" />
            <converters:EqualityConverter x:Key="EqualityConverter" />
            <converters:EqualityMultiConverter x:Key="EqMultiConv" />
            <converters:DuesColorConverter x:Key="DuesColorConv" />
            <converters:DuesLabelConverter x:Key="DuesLabelConv" />
            <converters:StockToBadgeBackgroundConverter x:Key="StockBgConv" />
            <converters:StockToBadgeForegroundConverter x:Key="StockFgConv" />
            <converters:StockToPillVisibilityConverter x:Key="StockPillVis" />
            <converters:StockToDeleteVisibilityConverter x:Key="StockDelVis" />
            <converters:PriceToDashConverter x:Key="PriceDashConv" />
            <converters:QuantityFormatConverter x:Key="QtyConv" />
            <converters:DepartmentBadgeBackgroundConverter x:Key="DeptBgConv" />
            <converters:DepartmentBadgeForegroundConverter x:Key="DeptFgConv" />
            <converters:DecimalPositiveToVisibilityConverter x:Key="DecPosToVis" />
            <converters:StringNotEmptyToVisibilityConverter x:Key="StrNotEmptyToVis" />
            <converters:NullToVisibilityConverter x:Key="NullToVis" />
            <converters:EqualityToVisibilityConverter x:Key="EqToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
