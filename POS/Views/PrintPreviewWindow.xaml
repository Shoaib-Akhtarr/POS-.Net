<Window x:Class="POS.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Document Preview &amp; Print (A4)"
        Width="940" Height="640" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgCanvasBrush}"
        Icon="/Resources/app.ico"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Action Bar -->
        <Border Grid.Row="0" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource Icon_Print}" Fill="{DynamicResource PrimaryBrush}" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock x:Name="TxtTitle" Text="Document Preview (A4)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Standard A4 Page Format · High Resolution Preview" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Zoom Controls -->
                    <Button Click="ZoomOut_Click" Content="−" Width="32" Height="32" FontSize="16" FontWeight="Bold" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0" ToolTip="Zoom Out"/>
                    <TextBlock x:Name="TxtZoomLevel" Text="100%" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,8,0" Width="44" TextAlignment="Center"/>
                    <Button Click="ZoomIn_Click" Content="+" Width="32" Height="32" FontSize="16" FontWeight="Bold" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,14,0" ToolTip="Zoom In"/>

                    <!-- Print Button -->
                    <Button Click="Print_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="16,9" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon_Print}" Fill="White" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Print (A4)" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <!-- Save as PDF Button -->
                    <Button Click="SavePdf_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="14,9" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon_StockIn}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Save as PDF" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- Close Button -->
                    <Button Click="Close_Click" Content="Close" Style="{StaticResource SecondaryButtonStyle}" Padding="14,9"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Center: FlowDocumentScrollViewer inside document container -->
        <Border Grid.Row="1" Background="#E2E8F0" Padding="24">
            <Border Background="White" CornerRadius="4" BorderBrush="#94A3B8" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="820">
                <FlowDocumentScrollViewer x:Name="DocViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsToolBarVisible="False" Background="White"/>
            </Border>
        </Border>
    </Grid>
</Window>
