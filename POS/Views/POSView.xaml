<UserControl x:Class="POS.Views.POSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:POS.Converters"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1120"
             Background="{DynamicResource BgCanvasBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Product Catalog -->
        <Grid Grid.Column="0" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Bar + View Toggle + Held Bills -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource Icon_Search}" Fill="{DynamicResource TextMutedBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1"
                                 x:Name="ProductSearchBox"
                                 Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchInnerTextBoxStyle}"
                                 conv:PlaceholderHelper.Placeholder="{DynamicResource Lang_ProductSearch}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding QuickAddFromSearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                </Border>

                <Button Grid.Column="1" Command="{Binding ToggleCatalogViewCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Padding="12,10" ToolTip="Switch Grid / Compact Table">
                    <Grid>
                        <Path Data="{StaticResource Icon_List}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" Visibility="{Binding IsCompactListView, Converter={StaticResource InverseBoolToVis}}"/>
                        <Path Data="{StaticResource Icon_Grid}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" Visibility="{Binding IsCompactListView, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Button>

                <Button Grid.Column="2" Command="{Binding OpenHeldCartsModalCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Visibility="{Binding HasHeldCarts, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Lang_HeldBills}"/>
                        <Border Background="{DynamicResource WarningBrush}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding HeldCartCount}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Dynamic Department Filter Chips -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,14">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Command="{Binding DataContext.ChangeCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Margin="0,0,8,0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="14,7"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgMutedBrush}"/>
                                                        </Trigger>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource EqMultiConv}">
                                                                    <Binding Path="."/>
                                                                    <Binding Path="DataContext.SelectedCategory" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Catalog View 1: Cards -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsCompactListView, Converter={StaticResource InverseBoolToVis}}">
                <ItemsControl ItemsSource="{Binding FilteredProducts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,12,12" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Card" Style="{StaticResource SurfaceCardStyle}" Width="184" Height="138" Padding="14">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Border Background="{Binding Category, Converter={StaticResource DeptBgConv}}" CornerRadius="6" Padding="7,2" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="{Binding Category, Converter={StaticResource DeptFgConv}}" TextTrimming="CharacterEllipsis" MaxWidth="82"/>
                                                    </Border>
                                                    <Border Background="{Binding Quantity, Converter={StaticResource StockBgConv}}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Quantity, Converter={StaticResource QtyConv}}" FontSize="10" FontWeight="Bold" Foreground="{Binding Quantity, Converter={StaticResource StockFgConv}}"/>
                                                            <TextBlock Text="{Binding Unit, StringFormat=' {0}'}" FontSize="10" Foreground="{Binding Quantity, Converter={StaticResource StockFgConv}}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <StackPanel Grid.Row="1" Margin="0,10,0,4">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Brand}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" Visibility="{Binding Brand, Converter={StaticResource StrNotEmptyToVis}}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                    <TextBlock Text="{Binding SellingPrice, StringFormat=Rs {0:N0}}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Black" FontSize="15"/>
                                                    <TextBlock Text="{Binding Unit, StringFormat=' / {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Catalog View 2: Compact Fast Table -->
            <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" Visibility="{Binding IsCompactListView, Converter={StaticResource BoolToVis}}">
                <DataGrid ItemsSource="{Binding FilteredProducts}" Style="{StaticResource ModernDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Barcode}" Width="95"/>
                        <DataGridTextColumn Header="ITEM" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="BRAND" Binding="{Binding Brand}" Width="100"/>
                        <DataGridTemplateColumn Header="STOCK" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Quantity, Converter={StaticResource StockBgConv}}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Quantity, Converter={StaticResource QtyConv}}" FontSize="11" FontWeight="Bold" Foreground="{Binding Quantity, Converter={StaticResource StockFgConv}}"/>
                                            <TextBlock Text="{Binding Unit, StringFormat=' {0}'}" FontSize="11" Foreground="{Binding Quantity, Converter={StaticResource StockFgConv}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="RATE" Binding="{Binding SellingPrice, StringFormat=Rs {0:N0}}" Width="90"/>
                        <DataGridTemplateColumn Header="" Width="75">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="+ Add"
                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="10,5" FontSize="11"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- RIGHT: Order Cart & Checkout Sidebar -->
        <Border Grid.Column="1" Background="{DynamicResource BgSurfaceBrush}" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource BorderDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cart Section -->
                <Grid Grid.Row="0" Margin="18,16,18,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Lang_OrderCart}" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <!-- FBR Active Indicator Pill -->
                            <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Visibility="{Binding IsFbrTaxEnabled, Converter={StaticResource BoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                                        <Style.Triggers>
                                             <DataTrigger Binding="{Binding IsFbrLive}" Value="True">
                                                 <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                             </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding FbrBadgeLabel}" FontSize="10" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFbrLive}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding HoldCurrentCartCommand}" Content="{DynamicResource Lang_HoldBill}" Style="{StaticResource GhostButtonStyle}" Padding="10,5" FontSize="11"/>
                            <Button Command="{Binding ClearCartCommand}" Content="{DynamicResource Lang_ClearCart}" Style="{StaticResource GhostButtonStyle}" Foreground="{DynamicResource DangerBrush}" Padding="10,5" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CartItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8" Padding="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 1: Item Name & Remove -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                <Button Grid.Column="1" Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand" Margin="6,0,0,0">
                                                    <Path Data="{StaticResource Icon_Close}" Fill="{DynamicResource DangerBrush}" Width="11" Height="11" Stretch="Uniform"/>
                                                </Button>
                                            </Grid>

                                            <!-- Row 2: Qty Controls, Unit Rate, Line Total -->
                                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Stepper + Editable Decimal Qty -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="-" Command="{Binding DataContext.DecrementCartItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0"/>
                                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=LostFocus}" Width="46" Height="26" Padding="2" Margin="4,0" TextAlignment="Center" FontWeight="Bold" FontSize="12" Style="{StaticResource ModernTextBoxStyle}"/>
                                                    <Button Content="+" Command="{Binding DataContext.IncrementCartItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0"/>
                                                    <TextBlock Text="{Binding Unit}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding UnitPrice, StringFormat=@ Rs {0:N0}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                                <TextBlock Grid.Column="2" Text="{Binding LineTotal, StringFormat=Rs {0:N0}}" FontWeight="Black" FontSize="14" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Row 3: Quick Edit / Serial / Pack Calc Links -->
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Content="Edit Price / S.N." Command="{Binding DataContext.OpenItemEditModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource GhostButtonStyle}" Padding="6,2" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                                <Button Content="Pack Calc" Command="{Binding DataContext.OpenPackCalcModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource GhostButtonStyle}" Padding="6,2" FontSize="11" Visibility="{Binding HasPackConversion, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding SerialNumber, StringFormat='S/N: {0}'}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="{Binding SerialNumber, Converter={StaticResource StrNotEmptyToVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Checkout Summary Footer (Scrollable on small screens) -->
                <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="18,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="440">
                        <StackPanel>
                            <!-- Customer Lookup or Selected Customer Pill -->
                            <Grid Margin="0,0,0,8">
                                <!-- Search Box + Popup Dropdown when Walk-in -->
                                <Grid Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVis}, ConverterParameter=Invert}">
                                    <TextBox x:Name="CustomerSearchBox"
                                             Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Padding="10,7"
                                             FontSize="12"
                                             conv:PlaceholderHelper.Placeholder="{DynamicResource Lang_CustomerSearch}"/>

                                    <Popup PlacementTarget="{Binding ElementName=CustomerSearchBox}"
                                           Placement="Top"
                                           IsOpen="{Binding IsCustomerDropdownOpen, Mode=TwoWay}"
                                           StaysOpen="False"
                                           AllowsTransparency="True">
                                        <Border Style="{StaticResource SurfaceCardStyle}" Width="370" MaxHeight="200" Padding="6">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding FilteredCustomers}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.SelectCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource GhostButtonStyle}"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Padding="10,7">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                        <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text="{Binding TotalDues, Converter={StaticResource CurrencyConv}}" FontSize="11" FontWeight="Bold" Foreground="{Binding TotalDues, Converter={StaticResource DuesColorConv}}" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <!-- Selected Customer Pill -->
                                <Border Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6"
                                        Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding SelectedCustomer.Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimarySoftTextBrush}"/>
                                            <TextBlock Text="{Binding SelectedCustomer.Phone}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding SelectedCustomer.Phone, Converter={StaticResource StrNotEmptyToVis}}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding ClearCustomerCommand}" Content="Walk-in ✕" Style="{StaticResource GhostButtonStyle}" Padding="8,4" FontSize="11" Foreground="{DynamicResource DangerBrush}"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Buyer CNIC & NTN for FBR Invoicing -->
                            <Grid Margin="0,0,0,8" Visibility="{Binding IsFbrTaxEnabled, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding BuyerCnic, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Padding="8,5" FontSize="11" conv:PlaceholderHelper.Placeholder="Buyer CNIC (Optional)"/>
                                <TextBox Grid.Column="2" Text="{Binding BuyerNtn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Padding="8,5" FontSize="11" conv:PlaceholderHelper.Placeholder="Buyer NTN (Optional)"/>
                            </Grid>

                            <!-- Payment Method & Site/Contractor Notes -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailablePaymentMethods}" SelectedItem="{Binding PaymentMethod}" Padding="8,6" FontSize="12"/>
                                <TextBox Grid.Column="2" Text="{Binding SaleNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Padding="10,6" FontSize="12" conv:PlaceholderHelper.Placeholder="{DynamicResource Lang_SiteNotes}"/>
                            </Grid>

                            <!-- Financial Breakdown -->
                            <Grid Margin="0,2,0,4" Visibility="{Binding IsFbrTaxEnabled, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Excl. Tax Value" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding TotalExclTax, StringFormat=Rs {0:N0}}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            </Grid>

                            <Grid Margin="0,2,0,4" Visibility="{Binding IsFbrTaxEnabled, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding FbrTaxRate, StringFormat='GST ({0:0.#}%)'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding FbrTaxAmount, StringFormat=Rs {0:N0}}" HorizontalAlignment="Right" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" FontSize="11"/>
                            </Grid>

                            <Grid Margin="0,2,0,4">
                                <TextBlock Text="{DynamicResource Lang_PrevDues}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedCustomer.TotalDues, StringFormat=Rs {0:N0}}" HorizontalAlignment="Right" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="12"/>
                            </Grid>

                            <Grid Margin="0,2,0,4">
                                <TextBlock Text="{DynamicResource Lang_Discount}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" Width="100" TextAlignment="Right" Padding="8,4" FontSize="12" FontWeight="Bold" Style="{StaticResource ModernTextBoxStyle}"/>
                            </Grid>

                            <Grid Margin="0,2,0,4">
                                <TextBlock Text="{DynamicResource Lang_BillNow}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding TotalAmount, StringFormat=Rs {0:N0}}" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13"/>
                            </Grid>

                            <Grid Margin="0,2,0,8" Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{DynamicResource Lang_TotalWithOld}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="{Binding TotalBillWithOld, StringFormat=Rs {0:N0}}" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Black"/>
                            </Grid>

                            <!-- Amount Paid + Quick Full/0 -->
                            <Border Background="{DynamicResource BgMutedBrush}" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Lang_PayNow}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" FontSize="12"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                        <Button Command="{Binding SetFullPaymentCommand}" Content="Full" Style="{StaticResource GhostButtonStyle}" Padding="6,2" FontSize="10"/>
                                        <Button Command="{Binding SetZeroPaymentCommand}" Content="0" Style="{StaticResource GhostButtonStyle}" Padding="6,2" FontSize="10" Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVis}}"/>
                                    </StackPanel>
                                    <TextBox x:Name="AmountPaidBox" Grid.Column="2" Text="{Binding AmountPaid, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Background="Transparent" BorderThickness="0" FontSize="17" FontWeight="Black" Foreground="{DynamicResource PrimaryBrush}" TextChanged="AmountPaidBox_TextChanged"/>
                                </Grid>
                            </Border>

                            <!-- Cash Tendered & Change Return (Cash Mode) -->
                            <Grid Margin="0,0,0,6" Visibility="{Binding PaymentMethod, Converter={StaticResource EqToVis}, ConverterParameter=Cash}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding CashTendered, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Padding="10,5" FontSize="12" conv:PlaceholderHelper.Placeholder="{DynamicResource Lang_CashTendered}"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Change: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding ChangeReturned, StringFormat=Rs {0:N0}}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8" Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{DynamicResource Lang_RemainingKhata}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="{Binding RemainingKhata, StringFormat=Rs {0:N0}}" HorizontalAlignment="Right" Foreground="{Binding RemainingKhata, Converter={StaticResource DuesColorConv}}" FontSize="15" FontWeight="Black"/>
                            </Grid>

                            <TextBlock Text="{Binding CreditLimitWarning}" Foreground="{DynamicResource DangerBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding CreditLimitWarning, Converter={StaticResource StrNotEmptyToVis}}"/>

                            <!-- Inline Status / Error Banner -->
                            <Border CornerRadius="8" Padding="10,7" Margin="0,0,0,8" Visibility="{Binding StatusMessage, Converter={StaticResource StrNotEmptyToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- Action Buttons -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding SaveAsEstimateCommand}" Content="{DynamicResource Lang_SaveEstimate}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,12" FontSize="11"/>
                                <Button Grid.Column="2" Command="{Binding CompleteSaleA4Command}" Content="{DynamicResource Lang_PrintA4}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,12" FontSize="11"/>
                                <Button Grid.Column="4" Command="{Binding CompleteSaleCommand}" Content="{DynamicResource Lang_ProcessCheckout}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,12" FontSize="13"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- MODAL 1: Line Item Edit (Decimal Qty, Negotiated Price + Owner Override, Serial/Warranty) -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsItemEditModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource SurfaceCardStyle}" Width="440" Padding="26" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding EditingCartItem.Name}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="QUANTITY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditItemQty, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="UNIT RATE (Rs)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditItemUnitPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="LINE DISCOUNT (Rs)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditItemDiscount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SERIAL NO. (SOLAR/ELEC)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditItemSerial, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" conv:PlaceholderHelper.Placeholder="Optional S/N"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="WARRANTY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditItemWarranty, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" conv:PlaceholderHelper.Placeholder="e.g. 1 Year"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Visibility="{Binding IsOwner, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,0,12">
                        <TextBlock Text="OWNER PIN (IF SELLING BELOW COST)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding OwnerOverridePin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" conv:PlaceholderHelper.Placeholder="Owner PIN only needed below cost"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ItemEditError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12" Visibility="{Binding ItemEditError, Converter={StaticResource StrNotEmptyToVis}}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding CloseItemEditModalCommand}" Content="{DynamicResource Lang_Cancel}" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Grid.Column="2" Command="{Binding SaveItemEditModalCommand}" Content="{DynamicResource Lang_SaveChanges}" Style="{StaticResource PrimaryButtonStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- MODAL 2: Box/Coil/Sq.Ft. Pack Calculator -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsPackCalcModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource SurfaceCardStyle}" Width="400" Padding="26" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Pack / Loose Unit Calculator" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding PackCalcItem.Name}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding PackCalcItem.PackUnitName, StringFormat='PACKS ({0})'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding PackCalcPacks, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding PackCalcItem.Unit, StringFormat='LOOSE ({0})'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding PackCalcLoose, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Total Quantity: " Foreground="{DynamicResource PrimarySoftTextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PackCalcTotalUnits, Converter={StaticResource QtyConv}}" Foreground="{DynamicResource PrimarySoftTextBrush}" FontWeight="Black"/>
                            <TextBlock Text="{Binding PackCalcItem.Unit, StringFormat=' {0}'}" Foreground="{DynamicResource PrimarySoftTextBrush}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding ClosePackCalcModalCommand}" Content="{DynamicResource Lang_Cancel}" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Grid.Column="2" Command="{Binding ApplyPackCalculationCommand}" Content="Apply Quantity" Style="{StaticResource PrimaryButtonStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- MODAL 3: Held Bills -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsHeldCartsModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource SurfaceCardStyle}" Width="460" MaxHeight="520" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource Lang_HeldBills}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding HeldCarts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding SummaryLabel}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding TotalEstimate, StringFormat=Rs {0:N0}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Resume" Command="{Binding DataContext.ResumeHeldCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButtonStyle}" Padding="10,6" FontSize="11" Margin="8,0"/>
                                            <Button Grid.Column="2" Content="✕" Command="{Binding DataContext.DeleteHeldCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DangerButtonStyle}" Padding="8,6" FontSize="11"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="2" Command="{Binding CloseHeldCartsModalCommand}" Content="{DynamicResource Lang_Close}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
