<UserControl x:Class="POS.Views.POSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:POS.Converters"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1200"
             Background="{DynamicResource BgCanvasBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="440"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- LEFT: PRODUCT CATALOG & SEARCH (65% width) -->
        <!-- ========================================== -->
        <Grid Grid.Column="0" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Search Bar + View Toggle + Held Bills -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input with Barcode Icon -->
                <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="14,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource Icon_Search}" Fill="{DynamicResource TextMutedBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1"
                                 x:Name="ProductSearchBox"
                                 Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchInnerTextBoxStyle}"
                                 FontSize="13"
                                 conv:PlaceholderHelper.Placeholder="Scan barcode or search product name, brand, SKU...">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding QuickAddFromSearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Border Grid.Column="2" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="Enter ↵ to Add" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Toggle Grid / List View -->
                <Button Grid.Column="1" Command="{Binding ToggleCatalogViewCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Padding="12,9" ToolTip="Switch Grid / Dense Table View">
                    <Grid>
                        <Path Data="{StaticResource Icon_List}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" Visibility="{Binding IsCompactListView, Converter={StaticResource InverseBoolToVis}}"/>
                        <Path Data="{StaticResource Icon_Grid}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" Visibility="{Binding IsCompactListView, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Button>

                <!-- Held Bills Pill -->
                <Button Grid.Column="2" Command="{Binding OpenHeldCartsModalCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Visibility="{Binding HasHeldCarts, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Lang_HeldBills}" FontSize="12" FontWeight="SemiBold"/>
                        <Border Background="{DynamicResource WarningBrush}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding HeldCartCount}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Horizontal Department Filter Chips -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,14">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Command="{Binding DataContext.ChangeCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Margin="0,0,8,0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="16" Padding="14,7">
                                                        <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgMutedBrush}"/>
                                                        </Trigger>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource EqMultiConv}">
                                                                    <Binding Path="."/>
                                                                    <Binding Path="DataContext.SelectedCategory" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                            <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                                                            <Setter TargetName="Txt" Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- CATALOG VIEW 1: Visual Cards with Product Images -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsCompactListView, Converter={StaticResource InverseBoolToVis}}">
                <ItemsControl ItemsSource="{Binding FilteredProducts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,14,14" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Card" Style="{StaticResource SurfaceCardStyle}" Width="195" Height="225" Padding="0" ClipToBounds="True">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="115"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <!-- Top: Product Image or Vector Fallback -->
                                                <Border Grid.Row="0" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" ClipToBounds="True">
                                                    <Grid>
                                                        <!-- Actual Product Photo -->
                                                        <Image Source="{Binding ImagePath, Converter={StaticResource SafeImageConv}}" Stretch="UniformToFill"
                                                               Visibility="{Binding ImagePath, Converter={StaticResource HasImageConv}, ConverterParameter=BoolToVis}"/>

                                                        <!-- Clean Pastel Vector Fallback when no photo exists -->
                                                        <Border Background="{Binding Category, Converter={StaticResource DeptBgConv}}"
                                                                Visibility="{Binding ImagePath, Converter={StaticResource HasImageConv}, ConverterParameter=Invert}">
                                                            <Path Data="{StaticResource Icon_Inventory}" Fill="{Binding Category, Converter={StaticResource DeptFgConv}}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Layered Badges over Image -->
                                                        <!-- Top Left: Department Badge -->
                                                        <Border Background="{Binding Category, Converter={StaticResource DeptBgConv}}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                                            <TextBlock Text="{Binding Category}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding Category, Converter={StaticResource DeptFgConv}}" TextTrimming="CharacterEllipsis" MaxWidth="80"/>
                                                        </Border>

                                                        <!-- Top Right: Stock Pill -->
                                                        <Border Background="{Binding Quantity, Converter={StaticResource StockBgConv}}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Quantity, Converter={StaticResource QtyConv}}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding Quantity, Converter={StaticResource StockFgConv}}"/>
                                                                <TextBlock Text="{Binding Unit, StringFormat=' {0}'}" FontSize="9.5" Foreground="{Binding Quantity, Converter={StaticResource StockFgConv}}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- Bottom: Product Metadata & Price -->
                                                <Grid Grid.Row="1" Margin="12,10,12,10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Grid.Row="0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Brand}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" Visibility="{Binding Brand, Converter={StaticResource StrNotEmptyToVis}}"/>
                                                    </StackPanel>

                                                    <!-- Price & Add Button -->
                                                    <Grid Grid.Row="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SellingPrice, StringFormat=Rs {0:N0}}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Black" FontSize="15"/>
                                                            <TextBlock Text="{Binding Unit, StringFormat='per {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9.5"/>
                                                        </StackPanel>

                                                        <!-- Mini Add Pill -->
                                                        <Border Grid.Column="1" Background="{DynamicResource PrimarySoftBrush}" CornerRadius="12" Padding="8,4" VerticalAlignment="Center">
                                                            <TextBlock Text="+ Add" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimarySoftTextBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter TargetName="Card" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12" Color="Black"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- CATALOG VIEW 2: Dense Table View -->
            <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" Visibility="{Binding IsCompactListView, Converter={StaticResource BoolToVis}}">
                <DataGrid ItemsSource="{Binding FilteredProducts}" Style="{StaticResource ModernDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="PHOTO" Width="55">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="34" Height="34" CornerRadius="6" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding ImagePath, Converter={StaticResource SafeImageConv}}" Stretch="UniformToFill"
                                                   Visibility="{Binding ImagePath, Converter={StaticResource HasImageConv}, ConverterParameter=BoolToVis}"/>
                                            <Path Data="{StaticResource Icon_Inventory}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{Binding ImagePath, Converter={StaticResource HasImageConv}, ConverterParameter=Invert}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="SKU / BARCODE" Binding="{Binding Barcode}" Width="110"/>
                        <DataGridTextColumn Header="PRODUCT NAME" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="BRAND" Binding="{Binding Brand}" Width="100"/>
                        <DataGridTemplateColumn Header="STOCK" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Quantity, Converter={StaticResource StockBgConv}}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Quantity, Converter={StaticResource QtyConv}}" FontSize="11" FontWeight="Bold" Foreground="{Binding Quantity, Converter={StaticResource StockFgConv}}"/>
                                            <TextBlock Text="{Binding Unit, StringFormat=' {0}'}" FontSize="11" Foreground="{Binding Quantity, Converter={StaticResource StockFgConv}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="RATE" Binding="{Binding SellingPrice, StringFormat=Rs {0:N0}}" Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="+ Add"
                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="10,5" FontSize="11"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ============================================== -->
        <!-- RIGHT: ORDER CART & CHECKOUT PANEL (35% width) -->
        <!-- ============================================== -->
        <Border Grid.Column="1" Background="{DynamicResource BgSurfaceBrush}" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource BorderDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TOP: Cart Line Items -->
                <Grid Grid.Row="0" Margin="18,16,18,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Cart Header Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Lang_OrderCart}" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CartItems.Count, StringFormat='{}{0} items'}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimarySoftTextBrush}"/>
                            </Border>
                            <!-- FBR Active Indicator Pill -->
                            <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding IsFbrTaxEnabled, Converter={StaticResource BoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                                        <Style.Triggers>
                                             <DataTrigger Binding="{Binding IsFbrLive}" Value="True">
                                                 <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                             </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding FbrBadgeLabel}" FontSize="10" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFbrLive}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding HoldCurrentCartCommand}" Content="{DynamicResource Lang_HoldBill}" Style="{StaticResource GhostButtonStyle}" Padding="8,4" FontSize="11"/>
                            <Button Command="{Binding ClearCartCommand}" Content="{DynamicResource Lang_ClearCart}" Style="{StaticResource GhostButtonStyle}" Foreground="{DynamicResource DangerBrush}" Padding="8,4" FontSize="11" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Line Items List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CartItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Thumbnail with Fallback -->
                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Margin="0,0,10,0" ClipToBounds="True" VerticalAlignment="Top">
                                                <Grid>
                                                    <Image Source="{Binding ImagePath, Converter={StaticResource SafeImageConv}}" Stretch="UniformToFill"
                                                           Visibility="{Binding ImagePath, Converter={StaticResource HasImageConv}, ConverterParameter=BoolToVis}"/>
                                                    <Path Data="{StaticResource Icon_Inventory}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Visibility="{Binding ImagePath, Converter={StaticResource HasImageConv}, ConverterParameter=Invert}"/>
                                                </Grid>
                                            </Border>

                                            <!-- Item Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" MaxWidth="210"/>
                                                </Grid>

                                                <!-- Stepper + Unit Rate -->
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="-" Command="{Binding DataContext.DecrementCartItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Width="24" Height="24" Padding="0"/>
                                                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=LostFocus}" Width="44" Height="24" Padding="1" Margin="4,0" TextAlignment="Center" FontWeight="Bold" FontSize="11.5" Style="{StaticResource ModernTextBoxStyle}"/>
                                                        <Button Content="+" Command="{Binding DataContext.IncrementCartItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Width="24" Height="24" Padding="0"/>
                                                        <TextBlock Text="{Binding Unit}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Text="{Binding UnitPrice, StringFormat=@ Rs {0:N0}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                </Grid>

                                                <!-- Links for Edit / S.N. -->
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Button Content="Edit Rate / S.N." Command="{Binding DataContext.OpenItemEditModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource GhostButtonStyle}" Padding="4,1" FontSize="10" Foreground="{DynamicResource PrimaryBrush}"/>
                                                    <Button Content="Pack Calc" Command="{Binding DataContext.OpenPackCalcModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource GhostButtonStyle}" Padding="4,1" FontSize="10" Visibility="{Binding HasPackConversion, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding SerialNumber, StringFormat='S/N: {0}'}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="{Binding SerialNumber, Converter={StaticResource StrNotEmptyToVis}}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Line Total & Delete -->
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Button Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand" HorizontalAlignment="Right">
                                                    <Path Data="{StaticResource Icon_Close}" Fill="{DynamicResource DangerBrush}" Width="10" Height="10" Stretch="Uniform"/>
                                                </Button>
                                                <TextBlock Text="{Binding LineTotal, StringFormat=Rs {0:N0}}" FontWeight="Black" FontSize="13.5" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- BOTTOM: Checkout Summary & Tender Controls -->
                <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="18,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="450">
                        <StackPanel>
                            <!-- 1. Customer Selection -->
                            <TextBlock Text="CUSTOMER (SELECT FOR KHATA ACCOUNT)" Style="{StaticResource FormLabelStyle}"/>
                            <Grid Margin="0,0,0,10">
                                <!-- Search Box + Dropdown Popup when Walk-in -->
                                <Grid Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVis}, ConverterParameter=Invert}">
                                    <TextBox x:Name="CustomerSearchBox"
                                             Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Padding="10,7"
                                             FontSize="12"
                                             conv:PlaceholderHelper.Placeholder="Walk-in Customer (Type name or phone for Khata...)"/>

                                    <Popup PlacementTarget="{Binding ElementName=CustomerSearchBox}"
                                           Placement="Top"
                                           IsOpen="{Binding IsCustomerDropdownOpen, Mode=TwoWay}"
                                           StaysOpen="False"
                                           AllowsTransparency="True">
                                        <Border Style="{StaticResource SurfaceCardStyle}" Width="390" MaxHeight="220" Padding="6">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding FilteredCustomers}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.SelectCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource GhostButtonStyle}"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Padding="10,7">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                        <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text="{Binding TotalDues, Converter={StaticResource CurrencyConv}}" FontSize="11" FontWeight="Bold" Foreground="{Binding TotalDues, Converter={StaticResource DuesColorConv}}" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <!-- Selected Customer Pill -->
                                <Border Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6"
                                        Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding SelectedCustomer.Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimarySoftTextBrush}"/>
                                            <TextBlock Text="{Binding SelectedCustomer.Phone}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding SelectedCustomer.Phone, Converter={StaticResource StrNotEmptyToVis}}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding ClearCustomerCommand}" Content="Walk-in ✕" Style="{StaticResource GhostButtonStyle}" Padding="8,4" FontSize="11" Foreground="{DynamicResource DangerBrush}"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 2. Payment Method & Optional Notes -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PAYMENT METHOD" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding AvailablePaymentMethods}" SelectedItem="{Binding PaymentMethod}" Padding="8,7" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SITE / CONTRACTOR NOTES (OPTIONAL)" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding SaleNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Padding="10,6" FontSize="12" conv:PlaceholderHelper.Placeholder="e.g. Site delivery, plumber reference..."/>
                                </StackPanel>
                            </Grid>

                            <!-- 3. Buyer Tax Details (Optional, when FBR active) -->
                            <Grid Margin="0,0,0,10" Visibility="{Binding IsFbrTaxEnabled, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="BUYER CNIC (OPTIONAL)" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding BuyerCnic, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Padding="8,5" FontSize="11" conv:PlaceholderHelper.Placeholder="13-digit CNIC"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="BUYER NTN (OPTIONAL)" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding BuyerNtn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Padding="8,5" FontSize="11" conv:PlaceholderHelper.Placeholder="7-digit NTN"/>
                                </StackPanel>
                            </Grid>

                            <!-- 4. Financial Calculations -->
                            <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Subtotal Amount" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding SubtotalAmount, StringFormat=Rs {0:N0}}" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Order Discount" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" Width="95" TextAlignment="Right" Padding="6,3" FontSize="12" FontWeight="Bold" Style="{StaticResource ModernTextBoxStyle}"/>
                                    </Grid>

                                    <!-- FBR Tax Row if enabled -->
                                    <Grid Margin="0,0,0,4" Visibility="{Binding IsFbrTaxEnabled, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding FbrTaxRate, StringFormat='GST Tax Included ({0:0.#}%)'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                        <TextBlock Text="{Binding FbrTaxAmount, StringFormat=Rs {0:N0}}" HorizontalAlignment="Right" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" FontSize="11"/>
                                    </Grid>

                                    <!-- Previous Dues if customer selected -->
                                    <Grid Margin="0,0,0,4" Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="Previous Account Dues" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding SelectedCustomer.TotalDues, StringFormat=Rs {0:N0}}" HorizontalAlignment="Right" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="12"/>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource BorderDefaultBrush}" Margin="0,6"/>

                                    <!-- Grand Total -->
                                    <Grid>
                                        <TextBlock Text="GRAND TOTAL" FontWeight="Black" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TotalAmount, StringFormat=Rs {0:N0}}" HorizontalAlignment="Right" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Black" FontSize="20"/>
                                    </Grid>

                                    <Grid Margin="0,2,0,0" Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="Total Bill with Previous Dues" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                        <TextBlock Text="{Binding TotalBillWithOld, StringFormat=Rs {0:N0}}" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 5. Amount Paid & Cash Tender -->
                            <Border Background="{DynamicResource BgMutedBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="AMOUNT PAID:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" FontSize="11.5"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                        <Button Command="{Binding SetFullPaymentCommand}" Content="Full" Style="{StaticResource GhostButtonStyle}" Padding="6,2" FontSize="10"/>
                                        <Button Command="{Binding SetZeroPaymentCommand}" Content="0" Style="{StaticResource GhostButtonStyle}" Padding="6,2" FontSize="10" Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVis}}"/>
                                    </StackPanel>
                                    <TextBox x:Name="AmountPaidBox" Grid.Column="2" Text="{Binding AmountPaid, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Background="Transparent" BorderThickness="0" FontSize="17" FontWeight="Black" Foreground="{DynamicResource PrimaryBrush}" TextChanged="AmountPaidBox_TextChanged"/>
                                </Grid>
                            </Border>

                            <!-- Cash Tendered & Change Return (Cash Mode) -->
                            <Grid Margin="0,0,0,6" Visibility="{Binding PaymentMethod, Converter={StaticResource EqToVis}, ConverterParameter=Cash}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding CashTendered, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Padding="10,6" FontSize="12" conv:PlaceholderHelper.Placeholder="Cash received from buyer"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Baqaya: " FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding ChangeReturned, StringFormat=Rs {0:N0}}" FontSize="15" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Cash Denominations -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding PaymentMethod, Converter={StaticResource EqToVis}, ConverterParameter=Cash}">
                                <Button Command="{Binding SetExactTenderCommand}" Content="Exact" Style="{StaticResource GhostButtonStyle}" Padding="8,3" FontSize="10.5" Margin="0,0,4,0"/>
                                <Button Command="{Binding AddTenderAmountCommand}" CommandParameter="500" Content="+500" Style="{StaticResource GhostButtonStyle}" Padding="8,3" FontSize="10.5" Margin="0,0,4,0"/>
                                <Button Command="{Binding AddTenderAmountCommand}" CommandParameter="1000" Content="+1,000" Style="{StaticResource GhostButtonStyle}" Padding="8,3" FontSize="10.5" Margin="0,0,4,0"/>
                                <Button Command="{Binding AddTenderAmountCommand}" CommandParameter="5000" Content="+5,000" Style="{StaticResource GhostButtonStyle}" Padding="8,3" FontSize="10.5" Margin="0,0,4,0"/>
                                <Button Command="{Binding ClearTenderCommand}" Content="Clear" Style="{StaticResource GhostButtonStyle}" Padding="8,3" FontSize="10.5"/>
                            </StackPanel>

                            <!-- Remaining Khata Balance for Customer -->
                            <Grid Margin="0,0,0,8" Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="Remaining Khata Due" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="{Binding RemainingKhata, StringFormat=Rs {0:N0}}" HorizontalAlignment="Right" Foreground="{Binding RemainingKhata, Converter={StaticResource DuesColorConv}}" FontSize="15" FontWeight="Black"/>
                            </Grid>

                            <TextBlock Text="{Binding CreditLimitWarning}" Foreground="{DynamicResource DangerBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding CreditLimitWarning, Converter={StaticResource StrNotEmptyToVis}}"/>

                            <!-- Primary Checkout Actions -->
                            <Button Command="{Binding CompleteSaleCommand}" Content="PROCESS CHECKOUT &amp; PRINT A4 (Ctrl+Enter / F9)" Style="{StaticResource PrimaryButtonStyle}" Padding="14,13" FontSize="13.5" Margin="0,4,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding SaveAsEstimateCommand}" Content="Quotation / Estimate (F8)" Style="{StaticResource SecondaryButtonStyle}" Padding="8,9" FontSize="11.5"/>
                                <Button Grid.Column="2" Command="{Binding CompleteSaleA4Command}" Content="Print A4 Invoice" Style="{StaticResource SecondaryButtonStyle}" Padding="8,9" FontSize="11.5"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- MODALS (Line Item Edit, Pack Calc, Held Carts) -->
        <!-- ============================================== -->
        <!-- Modal 1: Line Item Edit -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsItemEditModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource SurfaceCardStyle}" Width="440" Padding="26" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding EditingCartItem.Name}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="QUANTITY" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding EditItemQty, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="UNIT RATE (RS)" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding EditItemUnitPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="LINE DISCOUNT (RS)" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding EditItemDiscount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SERIAL NO. (OPTIONAL)" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding EditItemSerial, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" conv:PlaceholderHelper.Placeholder="e.g. S/N 98234"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="WARRANTY (OPTIONAL)" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding EditItemWarranty, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" conv:PlaceholderHelper.Placeholder="e.g. 1 Year"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Visibility="{Binding IsOwner, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,0,12">
                        <TextBlock Text="OWNER PIN (REQUIRED IF SELLING BELOW COST)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding OwnerOverridePin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" conv:PlaceholderHelper.Placeholder="Enter Owner PIN"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ItemEditError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12" Visibility="{Binding ItemEditError, Converter={StaticResource StrNotEmptyToVis}}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding CloseItemEditModalCommand}" Content="{DynamicResource Lang_Cancel}" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Grid.Column="2" Command="{Binding SaveItemEditModalCommand}" Content="{DynamicResource Lang_SaveChanges}" Style="{StaticResource PrimaryButtonStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Modal 2: Box / Coil / Loose Pack Calculator -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsPackCalcModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource SurfaceCardStyle}" Width="400" Padding="26" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Pack / Loose Unit Calculator" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding PackCalcItem.Name}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding PackCalcItem.PackUnitName, StringFormat='PACKS ({0})'}" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding PackCalcPacks, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding PackCalcItem.Unit, StringFormat='LOOSE ({0})'}" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding PackCalcLoose, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Total Calculated Quantity: " Foreground="{DynamicResource PrimarySoftTextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PackCalcTotalUnits, Converter={StaticResource QtyConv}}" Foreground="{DynamicResource PrimarySoftTextBrush}" FontWeight="Black"/>
                            <TextBlock Text="{Binding PackCalcItem.Unit, StringFormat=' {0}'}" Foreground="{DynamicResource PrimarySoftTextBrush}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding ClosePackCalcModalCommand}" Content="{DynamicResource Lang_Cancel}" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Grid.Column="2" Command="{Binding ApplyPackCalculationCommand}" Content="Apply Quantity" Style="{StaticResource PrimaryButtonStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Modal 3: Held Bills -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsHeldCartsModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource SurfaceCardStyle}" Width="460" MaxHeight="520" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource Lang_HeldBills}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding HeldCarts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding SummaryLabel}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding TotalEstimate, StringFormat=Rs {0:N0}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Resume" Command="{Binding DataContext.ResumeHeldCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButtonStyle}" Padding="10,6" FontSize="11" Margin="8,0"/>
                                            <Button Grid.Column="2" Content="✕" Command="{Binding DataContext.DeleteHeldCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DangerButtonStyle}" Padding="8,6" FontSize="11"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="2" Command="{Binding CloseHeldCartsModalCommand}" Content="{DynamicResource Lang_Close}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
