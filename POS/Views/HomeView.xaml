<UserControl x:Class="POS.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1050"
             Background="{DynamicResource BgCanvasBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header & Date Period Chips -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Lang_PerformanceOverview}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Aizaz Fareed Center &amp; Al-Kuwait Electronics" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <ItemsControl Grid.Column="1" ItemsSource="{Binding AvailablePeriods}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}"
                                Command="{Binding DataContext.ChangePeriodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Margin="6,0,0,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8">
                                                    <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgMutedBrush}"/>
                                                    </Trigger>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource EqMultiConv}">
                                                                <Binding Path="."/>
                                                                <Binding Path="DataContext.SelectedPeriod" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Line Chart Card -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,18" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="NET SALES TREND (LAST 7 DAYS)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="6" Padding="8,3" Margin="12,0,0,0">
                        <TextBlock Text="{Binding SelectedPeriod}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimarySoftTextBrush}"/>
                    </Border>
                </StackPanel>

                <lvc:CartesianChart Grid.Row="1" Series="{Binding SalesTrendSeries}" FlowDirection="LeftToRight">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Labels="{Binding TrendLabels}" Foreground="{DynamicResource TextMutedBrush}">
                            <lvc:Axis.Separator>
                                <lvc:Separator Step="1" IsEnabled="False"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis LabelFormatter="{Binding YFormatter}" Foreground="{DynamicResource TextMutedBrush}">
                            <lvc:Axis.Separator>
                                <lvc:Separator StrokeDashArray="3" Stroke="{DynamicResource BorderDefaultBrush}"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>
            </Grid>
        </Border>

        <!-- Summary KPI Cards -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Net Sales Revenue -->
            <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Margin="0,0,10,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Lang_SaleRevenue}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding TotalSalesRevenue, StringFormat=Rs {0:N0}}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Net Profit (Owner Only) -->
            <Border Grid.Column="1" Style="{StaticResource SurfaceCardStyle}" Margin="6,0,6,0" Padding="18">
                <Grid>
                    <StackPanel Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Lang_ProfitPeriod}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding WeeklyProfit, StringFormat=Rs {0:N0}}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsOwner, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="{DynamicResource Lang_ProfitPeriod}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Owner Only" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 3: Purchases (Owner Only) -->
            <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" Margin="6,0,6,0" Padding="18">
                <Grid>
                    <StackPanel Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Lang_PurchasePeriod}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding WeeklyPurchasesSum, StringFormat=Rs {0:N0}}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsOwner, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="{DynamicResource Lang_PurchasePeriod}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Owner Only" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 4: Customer Khata Dues -->
            <Border Grid.Column="3" Style="{StaticResource SurfaceCardStyle}" Margin="6,0,6,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Lang_PendingDues}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding TotalPendingDues, StringFormat=Rs {0:N0}}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 5: Low Stock Alerts -->
            <Button Grid.Column="4" Command="{Binding ToggleLowStockModalCommand}" Background="Transparent" BorderThickness="0" Padding="0" Margin="10,0,0,0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Lang_LowStock}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding LowInStockCount}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource DangerBrush}" Margin="0,8,0,0"/>
                                <TextBlock Text="{DynamicResource Lang_ViewItems}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Low Stock Modal Overlay -->
        <Grid Grid.RowSpan="3" Margin="-24" Visibility="{Binding IsLowStockModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource ModalOverlayBrush}" MouseDown="Border_MouseDown"/>

            <Border Style="{StaticResource SurfaceCardStyle}" MaxWidth="680" MaxHeight="650" Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource WarningSoftBrush}" Margin="0,0,12,0">
                            <Path Data="{StaticResource Icon_Warning}" Fill="{DynamicResource WarningBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Lang_LowStock}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="10" Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LowInStockCount, StringFormat={}{0} items}" Foreground="{DynamicResource DangerBrush}" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Stat Chips -->
                    <Grid Grid.Row="1" Margin="0,0,0,18" Visibility="{Binding IsAlertDismissed, Converter={StaticResource InverseBoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Lang_TotalAlerts}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding LowInStockCount}" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="6,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Lang_CriticalOut}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                                <TextBlock Text="{Binding CriticalAlertCount}" FontSize="18" FontWeight="Black" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Lang_LowestUnits}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding LowestUnitInfo}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Table -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding LowStockProducts}" Style="{StaticResource ModernDataGridStyle}" Margin="0,0,0,18"
                              Visibility="{Binding IsAlertDismissed, Converter={StaticResource InverseBoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PRODUCT NAME" Binding="{Binding Name}" Width="*"/>
                            <DataGridTemplateColumn Header="DEPARTMENT" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Category, Converter={StaticResource DeptBgConv}}" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="Bold" Foreground="{Binding Category, Converter={StaticResource DeptFgConv}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="STOCK" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Quantity, Converter={StaticResource StockBgConv}}" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Quantity, Converter={StaticResource QtyConv}}" FontSize="11" FontWeight="Bold" Foreground="{Binding Quantity, Converter={StaticResource StockFgConv}}"/>
                                                <TextBlock Text="{Binding Unit, StringFormat=' {0}'}" FontSize="11" Foreground="{Binding Quantity, Converter={StaticResource StockFgConv}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Dismissed State -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsAlertDismissed, Converter={StaticResource BoolToVis}}">
                        <Border Width="54" Height="54" CornerRadius="27" Background="{DynamicResource PrimarySoftBrush}" Margin="0,0,0,16">
                            <Path Data="{StaticResource Icon_Check}" Fill="{DynamicResource PrimaryBrush}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Lang_DismissedMessage}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Lang_DismissedSub}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,16" HorizontalAlignment="Center"/>
                        <Button Command="{Binding RestoreAlertCommand}" Content="{DynamicResource Lang_ReopenAlerts}" Style="{StaticResource GhostButtonStyle}"/>
                    </StackPanel>

                    <!-- Footer -->
                    <Grid Grid.Row="3">
                        <Button Command="{Binding DismissAlertCommand}" Content="ACKNOWLEDGE &amp; HIDE" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding IsAlertDismissed, Converter={StaticResource InverseBoolToVis}}"/>
                        <Button Command="{Binding ToggleLowStockModalCommand}" Content="{DynamicResource Lang_Done}" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding IsAlertDismissed, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
