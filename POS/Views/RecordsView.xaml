<UserControl x:Class="POS.Views.RecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:POS.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1150"
             Background="{DynamicResource BgCanvasBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP FILTER BAR -->
        <Border Grid.Row="0" Style="{StaticResource SurfaceCardStyle}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="RadioButton">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="16" Padding="14,7" Margin="0,0,6,0" BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}">
                                                <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgMutedBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>

                        <RadioButton Content="{DynamicResource Lang_AllRecords}" IsChecked="{Binding SelectedFilter, Converter={StaticResource EqualityConverter}, ConverterParameter='All'}"/>
                        <RadioButton Content="{DynamicResource Lang_SalesHistory}" IsChecked="{Binding SelectedFilter, Converter={StaticResource EqualityConverter}, ConverterParameter='Sales'}"/>
                        <RadioButton Content="{DynamicResource Lang_EstimatesHistory}" IsChecked="{Binding SelectedFilter, Converter={StaticResource EqualityConverter}, ConverterParameter='Estimates'}"/>
                        <RadioButton Content="{DynamicResource Lang_ReturnsHistory}" IsChecked="{Binding SelectedFilter, Converter={StaticResource EqualityConverter}, ConverterParameter='Returns'}"/>
                        <RadioButton Content="{DynamicResource Lang_PurchasesHistory}" IsChecked="{Binding SelectedFilter, Converter={StaticResource EqualityConverter}, ConverterParameter='Purchases'}"/>
                        <RadioButton Content="{DynamicResource Lang_PaymentsHistory}" IsChecked="{Binding SelectedFilter, Converter={StaticResource EqualityConverter}, ConverterParameter='Payments'}"/>
                    </StackPanel>
                </ScrollViewer>

                <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableDateRanges}" SelectedItem="{Binding SelectedDateRange}" Padding="10,7"/>

                <Button Grid.Column="4" Command="{Binding OpenZReportModalCommand}" Content="Daily Z-Report / Closing" Style="{StaticResource PrimaryButtonStyle}" Padding="12,7" FontWeight="SemiBold"/>

                <Border Grid.Column="6" Background="{DynamicResource BgSubtleBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Padding="12,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource Icon_Search}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchInnerTextBoxStyle}" conv:PlaceholderHelper.Placeholder="Search Ref, Customer, Notes..."/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- MASTER LEDGER TABLE -->
        <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource Lang_MasterLedger}" FontSize="15" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredRecords}" SelectedItem="{Binding SelectedRecord}" Style="{StaticResource ModernDataGridStyle}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRowStyle}">
                            <Setter Property="Cursor" Value="Hand"/>
                            <EventSetter Event="MouseLeftButtonUp" Handler="RecordRow_MouseLeftButtonUp"/>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DATE &amp; TIME" Binding="{Binding Date, StringFormat='dd MMM, HH:mm'}" Width="135"/>
                        <DataGridTemplateColumn Header="TYPE" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,3" CornerRadius="6" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource BgMutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="SALE">
                                                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="ESTIMATE">
                                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="RETURN">
                                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="PAYMENT">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="SALE">
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimarySoftTextBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="ESTIMATE">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="RETURN">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="PAYMENT">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="REFERENCE" Binding="{Binding RefId}" Width="165"/>
                        <DataGridTextColumn Header="CUSTOMER / SUPPLIER" Binding="{Binding Name}" Width="*"/>
                        <DataGridTemplateColumn Header="FBR FISCAL" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Padding="6,2" CornerRadius="4" Background="{DynamicResource SuccessSoftBrush}"
                                                Visibility="{Binding IsFbrSynced, Converter={StaticResource BoolToVis}}"
                                                ToolTip="{Binding FbrInvoiceNumber, StringFormat='FBR Inv: {0}'}">
                                            <TextBlock Text="{Binding FbrBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                        </Border>
                                        <Border Padding="6,2" CornerRadius="4" Background="{DynamicResource WarningSoftBrush}"
                                                Visibility="{Binding IsFbrPending, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Saved locally · Pending sync to FBR">
                                            <TextBlock Text="PENDING SYNC" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="STAFF" Binding="{Binding CreatedBy}" Width="110"/>
                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, Converter={StaticResource CurrencyConv}}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Black"/>
                                    <Setter Property="TextAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- DETAIL MODAL -->
        <Border Grid.RowSpan="3" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsDetailModalOpen, Converter={StaticResource BoolToVis}}" Margin="-24">
            <Border Style="{StaticResource SurfaceCardStyle}" Width="490" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="{Binding SelectedRecord.Type}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="{Binding SelectedRecord.RefId}" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Date" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding SelectedRecord.Date, StringFormat='dd MMM yyyy, HH:mm'}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Customer / Supplier" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding SelectedRecord.Name}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid Visibility="{Binding SelectedRecord.Notes, Converter={StaticResource StrNotEmptyToVis}}" Margin="0,0,0,6">
                                <TextBlock Text="Site / Notes" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding SelectedRecord.Notes}" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid Visibility="{Binding SelectedRecord.HasFbr, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="FBR Fiscal Invoice" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SelectedRecord.FbrInvoiceNumber}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,8,0"/>
                                    <Button Command="{Binding SyncSingleFbrRecordCommand}" CommandParameter="{Binding SelectedRecord}"
                                            Content="Sync to FBR" Visibility="{Binding SelectedRecord.IsFbrPending, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="6,2" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="2" MaxHeight="220" Margin="0,0,0,14" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedRecord.Details}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,8" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="3" Text="{Binding ActionError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10" Visibility="{Binding ActionError, Converter={StaticResource StrNotEmptyToVis}}"/>

                    <StackPanel Grid.Row="4">
                        <Grid Margin="0,0,0,10" Visibility="{Binding SelectedRecord.IsSaleType, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding ReprintThermalCommand}" Content="Reprint 80mm" Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button Grid.Column="2" Command="{Binding PrintA4Command}" Content="Print A4 Invoice" Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>

                        <Button Command="{Binding ConvertEstimateToSaleCommand}" Content="Convert Estimate to Sale" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" Visibility="{Binding SelectedRecord.IsEstimate, Converter={StaticResource BoolToVis}}"/>
                        <Button Command="{Binding OpenReturnModalCommand}" Content="Process Item Return / Refund" Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,8" Visibility="{Binding SelectedRecord.IsReturnableSale, Converter={StaticResource BoolToVis}}"/>
                        <Button Command="{Binding CloseDetailCommand}" Content="{DynamicResource Lang_Close}" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- SALE RETURN MODAL -->
        <Border Grid.RowSpan="3" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsReturnModalOpen, Converter={StaticResource BoolToVis}}" Margin="-24">
            <Border Style="{StaticResource SurfaceCardStyle}" Width="520" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="PROCESS SALE RETURN" FontSize="17" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Command="{Binding SelectAllForReturnCommand}" Content="Return All" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" MaxHeight="260" Margin="0,0,0,14" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ReturnItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="95"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Sold: " FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding MaxQuantity, Converter={StaticResource QtyConv}}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding Unit, StringFormat=' {0}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Text="{Binding ReturnQuantity, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernTextBoxStyle}" TextAlignment="Center" Padding="6"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ReturnTotal, StringFormat='Rs {0:N0}'}" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,0,0,14">
                        <TextBox Text="{Binding ReturnNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" conv:PlaceholderHelper.Placeholder="Reason for return (optional)" Margin="0,0,0,10"/>
                        <Grid>
                            <TextBlock Text="REFUND / KHATA CREDIT TOTAL" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ReturnRefundTotal, StringFormat='Rs {0:N0}'}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding ActionError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding ActionError, Converter={StaticResource StrNotEmptyToVis}}"/>
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding CloseReturnModalCommand}" Content="{DynamicResource Lang_Cancel}" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Grid.Column="2" Command="{Binding ConfirmReturnCommand}" Content="CONFIRM RETURN" Style="{StaticResource DangerButtonStyle}"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- DAILY CLOSING / Z-REPORT MODAL -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsZReportModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource SurfaceCardStyle}" Width="620" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="DAILY CASH REGISTER CLOSING (Z-REPORT)" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Day-end cash drawer reconciliation and Roznamcha summary" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Command="{Binding CloseZReportModalCommand}" Content="✕" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,4"/>
                    </Grid>

                    <!-- Date Selector & Refresh -->
                    <Border Grid.Row="1" Background="{DynamicResource BgSubtleBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Report Date:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding ZReportDate, Mode=TwoWay}"/>
                            <Button Grid.Column="3" Command="{Binding CalculateZReportCommand}" Content="Recalculate" Style="{StaticResource GhostButtonStyle}" Padding="8,4"/>
                        </Grid>
                    </Border>

                    <!-- Breakdown Cards Grid -->
                    <ScrollViewer Grid.Row="2" MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Inflows Summary -->
                            <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="1. CASH &amp; REVENUE INFLOWS" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Cash Sales (Counter)" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding ZReportData.CashSales, StringFormat='PKR {0:N2}'}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Card / Bank / Raast Sales" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding ZReportData.CardSales, StringFormat='PKR {0:N2}'}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Khata Wasooli (Customer Cash In)" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding ZReportData.KhataCashIn, StringFormat='PKR {0:N2}'}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Installment Recoveries &amp; Advance" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding ZReportData.InstallmentRecoveries, StringFormat='PKR {0:N2}'}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Separator Margin="0,6"/>
                                    <Grid>
                                        <TextBlock Text="TOTAL CASH INFLOW TO DRAWER" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text="{Binding ZReportData.TotalCashInflow, StringFormat='PKR {0:N2}'}" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Outflows Summary -->
                            <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="2. CASH OUTFLOWS &amp; EXPENSES" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Supplier Payments, Returns &amp; Shop Expenses" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding ZReportData.CashOutExpenses, StringFormat='PKR {0:N2}'}" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Drawer Reconciliation -->
                            <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="3. DRAWER RECONCILIATION" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="System Expected Cash in Drawer" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding ZReportData.ExpectedDrawerCash, StringFormat='PKR {0:N2}'}" FontSize="15" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,8,0,4">
                                        <TextBlock Text="Counted Physical Cash in Drawer" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <TextBox Text="{Binding CountedDrawerCash, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}" Width="160" HorizontalAlignment="Right" TextAlignment="Right" Style="{StaticResource ModernTextBoxStyle}" FontWeight="Bold" FontSize="14" Padding="6,4"/>
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <TextBlock Text="Drawer Variance (Shortage / Surplus)" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding DrawerVariance, StringFormat='PKR {0:+#,##0.00;-#,##0.00;0.00}'}" FontWeight="Black" FontSize="14" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Status Notification -->
                    <TextBlock Grid.Row="3" Text="{Binding ZReportStatus}" Foreground="{DynamicResource SuccessBrush}" FontSize="11" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding CloseZReportModalCommand}" Content="Close" Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"/>
                        <Button Grid.Column="2" Command="{Binding PrintZReportCommand}" Content="Print Z-Report Slip" Style="{StaticResource PrimaryButtonStyle}" Padding="14,8"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
