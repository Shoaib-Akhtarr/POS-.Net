<UserControl x:Class="POS.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:POS.Converters"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1050"
             Background="{DynamicResource BgCanvasBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header & Mode Toggle -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{DynamicResource Lang_StockProcurement}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <RadioButton Grid.Column="0" IsChecked="{Binding IsNewProduct}" Cursor="Hand">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                                <TextBlock x:Name="Txt" Text="{DynamicResource Lang_NewArrival}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                    <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource PrimarySoftTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>

                <RadioButton Grid.Column="2" IsChecked="{Binding IsNewProduct, Mode=TwoWay, Converter={StaticResource InverseBool}}" Cursor="Hand">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                                <TextBlock x:Name="Txt" Text="{DynamicResource Lang_RestockExisting}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                    <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource PrimarySoftTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
            </Grid>
        </StackPanel>

        <!-- Procurement Form -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" Padding="20" Margin="0,0,0,18">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SUPPLIER NAME *" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" conv:PlaceholderHelper.Placeholder="e.g. Lahore Cable Traders"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PRODUCT *" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <Grid>
                            <ComboBox Visibility="{Binding IsNewProduct, Converter={StaticResource InverseBoolToVis}}"
                                      ItemsSource="{Binding AvailableProducts}"
                                      SelectedItem="{Binding SelectedProduct}"
                                      DisplayMemberPath="Name"
                                      TextSearch.TextPath="Name"
                                      IsEditable="True" Padding="10,8"/>
                            <TextBox Visibility="{Binding IsNewProduct, Converter={StaticResource BoolToVis}}"
                                     Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     conv:PlaceholderHelper.Placeholder="New product name"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="DEPARTMENT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableDepartments}" Text="{Binding Category}" IsEditable="True" Padding="10,8" IsEnabled="{Binding IsNewProduct}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="UNIT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableUnits}" Text="{Binding Unit}" IsEditable="True" Padding="10,8" IsEnabled="{Binding IsNewProduct}"/>
                    </StackPanel>
                </Grid>

                <!-- Optional New Product Metadata -->
                <Grid Margin="0,0,0,12" Visibility="{Binding IsNewProduct, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="BARCODE / SKU" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="BRAND" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="PACK NAME / UNITS PER PACK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding PackUnitName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" conv:PlaceholderHelper.Placeholder="box/coil"/>
                            <TextBox Grid.Column="2" Text="{Binding UnitsPerPack, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernTextBoxStyle}"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="WARRANTY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding DefaultWarranty, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" conv:PlaceholderHelper.Placeholder="1 Year"/>
                    </StackPanel>
                </Grid>

                <!-- Financials & Quantity -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="UNIT COST (Rs) *" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="QUANTITY *" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding DecrementQuantityCommand}" Content="-" Style="{StaticResource SecondaryButtonStyle}" Padding="0" Height="38"/>
                            <TextBox Grid.Column="1" Text="{Binding Quantity, UpdateSourceTrigger=LostFocus}" Margin="6,0" TextAlignment="Center" FontWeight="Bold" FontSize="15" Style="{StaticResource ModernTextBoxStyle}"/>
                            <Button Grid.Column="2" Command="{Binding IncrementQuantityCommand}" Content="+" Style="{StaticResource SecondaryButtonStyle}" Padding="0" Height="38"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="SELLING PRICE (Rs)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Status Banner -->
                <Border CornerRadius="8" Padding="10,7" Margin="0,0,0,10" Visibility="{Binding StatusMessage, Converter={StaticResource StrNotEmptyToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Button Command="{Binding RecordPurchaseCommand}" Content="{DynamicResource Lang_RecordRestock}" Style="{StaticResource PrimaryButtonStyle}" Height="44"/>
            </StackPanel>
        </Border>

        <!-- Audit Log Table -->
        <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}">
            <DataGrid ItemsSource="{Binding Purchases}" Style="{StaticResource ModernDataGridStyle}">
                <DataGrid.Resources>
                    <conv:BindingProxy x:Key="PurProxy" Data="{Binding}"/>
                </DataGrid.Resources>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRowStyle}">
                        <Setter Property="Cursor" Value="Hand"/>
                        <EventSetter Event="MouseLeftButtonUp" Handler="DataGridRow_MouseLeftButtonUp"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DATE" Binding="{Binding PurchaseDate, StringFormat='dd MMM, HH:mm'}" Width="130"/>
                    <DataGridTextColumn Header="SUPPLIER" Binding="{Binding SupplierName}" Width="180"/>
                    <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTemplateColumn Header="QTY" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Quantity, Converter={StaticResource QtyConv}}" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Unit, StringFormat=' {0}'}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="TOTAL COST" Binding="{Binding TotalCost, StringFormat=Rs {0:N0}}" Width="130"
                                        Visibility="{Binding Data.IsOwner, Source={StaticResource PurProxy}, Converter={StaticResource BoolToVis}}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Purchase Detail Modal -->
        <Grid Grid.RowSpan="3" Margin="-24" Visibility="{Binding IsDetailModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource ModalOverlayBrush}" MouseDown="Border_MouseDown"/>
            <Border Style="{StaticResource SurfaceCardStyle}" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26">
                <StackPanel>
                    <TextBlock Text="PROCUREMENT DETAILS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding SelectedPurchaseHistory.ProductName}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Supplier" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding SelectedPurchaseHistory.SupplierName}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Date" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding SelectedPurchaseHistory.PurchaseDate, StringFormat='dd MMM yyyy, HH:mm'}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Quantity" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SelectedPurchaseHistory.Quantity, Converter={StaticResource QtyConv}}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedPurchaseHistory.Unit, StringFormat=' {0}'}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Total Cost" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding SelectedPurchaseHistory.TotalCost, StringFormat=Rs {0:N0}}" HorizontalAlignment="Right" FontSize="16" FontWeight="Black" Foreground="{DynamicResource PrimaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding CloseDetailCommand}" Content="{DynamicResource Lang_Done}" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
