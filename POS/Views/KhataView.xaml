<UserControl x:Class="POS.Views.KhataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:POS.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{DynamicResource BgCanvasBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="190"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Party Khata" FontSize="24" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Customer receivables, supplier payables and cheque clearing" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="2" Command="{Binding PrintDailyCashBookCommand}" Content="Roznamcha" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Grid.Column="4" Command="{Binding OpenCashOutCommand}" Content="Cash out · Adaigi" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Grid.Column="6" Command="{Binding OpenCashInCommand}" Content="Cash in · Wasooli" Style="{StaticResource PrimaryButtonStyle}"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="PARTY ACCOUNTS" FontSize="12" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Command="{Binding OpenAccountModalCommand}" Content="+ Add supplier / agent" Style="{StaticResource GhostButtonStyle}" Padding="8,4" FontSize="10"/>
                    </Grid>
                    <TextBox Grid.Row="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Padding="9,7" conv:PlaceholderHelper.Placeholder="Search party, type or phone"/>
                    <DataGrid Grid.Row="4" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" Style="{StaticResource ModernDataGridStyle}" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="PARTY" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Account.Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Account.PartyType}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="BALANCE" Binding="{Binding AbsoluteBalance, StringFormat=PKR {0:N2}}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/><Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedAccount.Account.Name, TargetNullValue=Select a party ledger}" FontSize="17" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding SelectedAccount.BalanceLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedAccount.AbsoluteBalance, StringFormat=PKR {0:N2}}" HorizontalAlignment="Right" FontSize="22" FontWeight="Black" Foreground="{DynamicResource PrimaryBrush}"/>
                            <Button Command="{Binding PrintSelectedStatementCommand}" Content="Print / PDF statement" Style="{StaticResource GhostButtonStyle}" Padding="6,2" HorizontalAlignment="Right" FontSize="10"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Entries}" Style="{StaticResource ModernDataGridStyle}" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat=dd MMM yy}" Width="84"/>
                            <DataGridTextColumn Header="VOUCHER" Binding="{Binding Voucher}" Width="125"/>
                            <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="MODE" Binding="{Binding Mode}" Width="92"/>
                            <DataGridTextColumn Header="BANAAM / DR" Binding="{Binding Debit, StringFormat={}{0:N2}}" Width="100">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="JAMA / CR" Binding="{Binding Credit, StringFormat={}{0:N2}}" Width="100">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="BALANCE" Binding="{Binding RunningBalance, StringFormat={}{0:N2}}" Width="105">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="FontWeight" Value="Bold"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource SurfaceCardStyle}" Padding="14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="POST-DATED CHEQUES" FontSize="12" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="7" Padding="7,2" Margin="8,0,0,0">
                            <TextBlock Text="{Binding PendingChequeCount, StringFormat={}{0} pending}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBox Text="{Binding BounceReason, UpdateSourceTrigger=PropertyChanged}" Width="200" Style="{StaticResource ModernTextBoxStyle}" Padding="7,4" Margin="0,0,8,0" conv:PlaceholderHelper.Placeholder="Reason if bounced"/>
                        <Button Command="{Binding ClearSelectedChequeCommand}" Content="Mark cleared" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="0,0,6,0"/>
                        <Button Command="{Binding BounceSelectedChequeCommand}" Content="Mark bounced" Style="{StaticResource DangerButtonStyle}" Padding="10,5"/>
                    </StackPanel>
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Instruments}" SelectedItem="{Binding SelectedInstrument}" Style="{StaticResource ModernDataGridStyle}" IsReadOnly="True" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PARTY" Binding="{Binding PartyName}" Width="*"/>
                        <DataGridTextColumn Header="DIRECTION" Binding="{Binding Instrument.Direction}" Width="90"/>
                        <DataGridTextColumn Header="CHEQUE #" Binding="{Binding Instrument.ChequeNumber}" Width="115"/>
                        <DataGridTextColumn Header="BANK" Binding="{Binding Instrument.BankName}" Width="140"/>
                        <DataGridTextColumn Header="CLEARING DATE" Binding="{Binding Instrument.ClearingDate, StringFormat=dd MMM yyyy}" Width="125"/>
                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding Instrument.Amount, StringFormat=PKR {0:N2}}" Width="125"/>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Instrument.Status}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.RowSpan="5" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsAccountModalOpen, Converter={StaticResource BoolToVis}}" Margin="-22">
            <Border Style="{StaticResource SurfaceCardStyle}" Width="470" MaxHeight="680" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="NEW PARTY LEDGER" FontSize="17" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,18"/>
                        <TextBlock Text="PARTY TYPE" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding PartyTypes}" SelectedItem="{Binding NewPartyType}" Padding="9,7" Margin="0,0,0,12"/>
                        <TextBlock Text="NAME *" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding NewPartyName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>
                        <TextBlock Text="PHONE" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding NewPartyPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>
                        <TextBlock Text="CNIC" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding NewPartyCnic, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>
                        <TextBlock Text="FATHER / HUSBAND NAME" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding NewPartyFatherName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>
                        <TextBlock Text="ADDRESS" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding NewPartyAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>
                        <TextBlock Text="CREDIT LIMIT (PKR, 0 = UNLIMITED)" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding NewPartyCreditLimit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,14"/>
                        <TextBlock Text="OPENING BALANCE SIDE" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding OpeningBalanceSides}" SelectedItem="{Binding NewPartyOpeningSide}" Padding="8,6" Margin="0,0,0,10"/>
                        <TextBlock Text="OPENING BALANCE (PKR)" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding NewPartyOpeningBalance, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,14"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <UniformGrid Columns="2">
                            <Button Command="{Binding CloseModalCommand}" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,5,0"/>
                            <Button Command="{Binding SavePartyAccountCommand}" Content="Create ledger" Style="{StaticResource PrimaryButtonStyle}" Margin="5,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <Border Grid.RowSpan="5" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsPaymentModalOpen, Converter={StaticResource BoolToVis}}" Margin="-22">
            <Border Style="{StaticResource SurfaceCardStyle}" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26">
                <StackPanel>
                    <TextBlock Text="{Binding PaymentDirection, StringFormat=Payment · {0}}" FontSize="17" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding SelectedAccount.Account.Name}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,18"/>
                    <TextBlock Text="AMOUNT (PKR)" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" FontSize="19" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Text="PAYMENT METHOD" Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding PaymentMode}" Padding="9,7" Margin="0,0,0,12"/>
                    <StackPanel Visibility="{Binding IsPdc, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="INSTALLMENT CONTRACT (OPTIONAL)" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding ActiveContracts}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SelectedInstallmentContractId}" Padding="8,6" Margin="0,0,0,10"/>
                        <TextBlock Text="CHEQUE NUMBER" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding ChequeNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,10"/>
                        <TextBlock Text="BANK NAME" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,10"/>
                        <TextBlock Text="CLEARING DATE" Style="{StaticResource FormLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding ClearingDate}" Margin="0,0,0,10"/>
                    </StackPanel>
                    <TextBlock Text="REFERENCE / NOTES" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding PaymentNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,14"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <UniformGrid Columns="2">
                        <Button Command="{Binding CloseModalCommand}" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,5,0"/>
                        <Button Command="{Binding SavePaymentCommand}" Content="Post" Style="{StaticResource PrimaryButtonStyle}" Margin="5,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
