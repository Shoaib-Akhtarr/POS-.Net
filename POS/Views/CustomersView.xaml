<UserControl x:Class="POS.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:POS.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1150"
             Background="{DynamicResource BgCanvasBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Style="{StaticResource SurfaceCardStyle}" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding OpenAddModalCommand}" Content="{DynamicResource Lang_NewCustomer}" Style="{StaticResource PrimaryButtonStyle}"/>

                <Border Grid.Column="2" Background="{DynamicResource BgSubtleBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource Icon_Search}" Fill="{DynamicResource TextMutedBrush}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchInnerTextBoxStyle}" conv:PlaceholderHelper.Placeholder="{DynamicResource Lang_CustomerSearch}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- CONTENT AREA -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="460"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL 1: CUSTOMER DIRECTORY -->
            <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource Lang_CustomerDirectory}" FontSize="14" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredCustomers}" SelectedItem="{Binding SelectedCustomer}" Style="{StaticResource ModernDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="CUSTOMER" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="34" Height="34" Background="{DynamicResource PrimarySoftBrush}" CornerRadius="17" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Name, Converter={StaticResource InitialConv}}" Foreground="{DynamicResource PrimarySoftTextBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                <TextBlock Text="{Binding Address}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Visibility="{Binding Address, Converter={StaticResource StrNotEmptyToVis}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="125"/>

                            <DataGridTextColumn Header="KHATA DUES" Binding="{Binding TotalDues, Converter={StaticResource CurrencyConv}}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Black"/>
                                        <Setter Property="Foreground" Value="{Binding TotalDues, Converter={StaticResource DuesColorConv}}"/>
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- PANEL 2: CUSTOMER LEDGER -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Hero Balance Card -->
                <Border Grid.Row="0" Style="{StaticResource SurfaceCardStyle}" Padding="20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TOTAL KHATA BALANCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SelectedCustomer.TotalDues, Converter={StaticResource CurrencyConv}}" FontSize="28" FontWeight="Black" Foreground="{Binding SelectedCustomer.TotalDues, Converter={StaticResource DuesColorConv}}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding OpenEditModalCommand}" Content="Edit Info" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" FontSize="11" VerticalAlignment="Top" Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVis}}"/>
                        </Grid>

                        <Grid Margin="0,14,0,0" Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding OpenPaymentModalCommand}" Content="{DynamicResource Lang_ReceivePayment}" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Grid.Column="2" Command="{Binding PrintKhataStatementCommand}" Content="{DynamicResource Lang_PrintLedger}" Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Account Ledger Table -->
                <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource Lang_AccountLedger}" FontSize="13" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Background="{DynamicResource PrimarySoftBrush}" CornerRadius="8" Padding="8,3">
                                <TextBlock Text="{Binding CustomerHistory.Count, StringFormat='{}{0} entries'}" Foreground="{DynamicResource PrimarySoftTextBrush}" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding CustomerHistory}" Style="{StaticResource ModernDataGridStyle}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRowStyle}">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <EventSetter Event="MouseLeftButtonUp" Handler="ArchiveRow_MouseLeftButtonUp"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DATE" Binding="{Binding CreatedAt, StringFormat=dd MMM}" Width="68"/>
                                <DataGridTextColumn Header="TYPE" Binding="{Binding RecordType}" Width="75"/>
                                <DataGridTextColumn Header="DEBIT" Binding="{Binding TotalAmount, Converter={StaticResource PriceDashConv}}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="PAID" Binding="{Binding AmountPaid, Converter={StaticResource PriceDashConv}}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ADD / EDIT CUSTOMER MODAL -->
        <Border Grid.RowSpan="3" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsAddModalOpen, Converter={StaticResource BoolToVis}}" Margin="-24">
            <Border Style="{StaticResource SurfaceCardStyle}" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26">
                <StackPanel>
                    <TextBlock Text="{Binding CustomerModalTitle}" FontSize="17" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,18"/>

                    <TextBlock Text="CUSTOMER / CONTRACTOR NAME *" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                    <TextBlock Text="PHONE NUMBER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                    <TextBlock Text="ADDRESS / SITE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewCustomerAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                    <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,0,14">
                        <TextBlock Text="INITIAL OPENING DUES (Rs)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewCustomerInitialDues, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ModalError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12" Visibility="{Binding ModalError, Converter={StaticResource StrNotEmptyToVis}}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding CloseModalsCommand}" Content="{DynamicResource Lang_Cancel}" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Grid.Column="2" Command="{Binding SaveCustomerCommand}" Content="{DynamicResource Lang_SaveChanges}" Style="{StaticResource PrimaryButtonStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- RECEIVE PAYMENT MODAL -->
        <Border Grid.RowSpan="3" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsPaymentModalOpen, Converter={StaticResource BoolToVis}}" Margin="-24">
            <Border Style="{StaticResource SurfaceCardStyle}" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26">
                <StackPanel>
                    <TextBlock Text="RECEIVE KHATA PAYMENT" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding SelectedCustomer.Name}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,16"/>

                    <TextBlock Text="AMOUNT (Rs)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" FontSize="20" FontWeight="Black" Margin="0,0,0,12"/>

                    <TextBlock Text="PAYMENT METHOD" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailablePaymentMethods}" SelectedItem="{Binding PaymentMethod}" Padding="10,8" Margin="0,0,0,12"/>

                    <TextBlock Text="NOTES (OPTIONAL)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PaymentNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,14"/>

                    <TextBlock Text="{Binding ModalError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12" Visibility="{Binding ModalError, Converter={StaticResource StrNotEmptyToVis}}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding CloseModalsCommand}" Content="{DynamicResource Lang_Cancel}" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Grid.Column="2" Command="{Binding ProcessPaymentCommand}" Content="CONFIRM PAYMENT" Style="{StaticResource PrimaryButtonStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- FIXED RECEIPT DETAILS MODAL -->
        <Border Grid.RowSpan="3" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsReceiptModalOpen, Converter={StaticResource BoolToVis}}" Margin="-24">
            <Border Style="{StaticResource SurfaceCardStyle}" Width="460" MaxHeight="680" VerticalAlignment="Center" HorizontalAlignment="Center" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Padding="22,16">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedSaleHistory.RecordType}" FontSize="11" FontWeight="Bold" Foreground="White" Opacity="0.85"/>
                                <TextBlock Text="{Binding SelectedSaleHistory.ReceiptNumber}" FontSize="16" FontWeight="Black" Foreground="White"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedSaleHistory.CreatedAt, StringFormat='dd MMM yyyy, HH:mm'}" Foreground="White" Opacity="0.9" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="22,16,22,10">
                        <TextBlock Text="{Binding SelectedSaleHistory.CustomerName}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding SelectedSaleHistory.Notes}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="{Binding SelectedSaleHistory.Notes, Converter={StaticResource StrNotEmptyToVis}}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" MaxHeight="230" Margin="22,0,22,12" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedSaleHistory.SaleItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Quantity, Converter={StaticResource QtyConv}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding Unit, StringFormat=' {0} @ '}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding EffectiveUnitPrice, StringFormat='Rs {0:N0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat='Rs {0:N0}'}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="3" Margin="22,0,22,16" Background="{DynamicResource BgSubtleBrush}" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,6" Visibility="{Binding SelectedSaleHistory.TotalAmount, Converter={StaticResource DecPosToVis}}">
                                <TextBlock Text="Bill Total" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding SelectedSaleHistory.TotalAmount, StringFormat='Rs {0:N0}'}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,6" Visibility="{Binding SelectedSaleHistory.PreviousDues, Converter={StaticResource DecPosToVis}}">
                                <TextBlock Text="Previous Balance" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding SelectedSaleHistory.PreviousDues, StringFormat='Rs {0:N0}'}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{Binding SelectedSaleHistory.PaymentMethod, StringFormat='Amount Paid ({0})'}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedSaleHistory.AmountPaid, StringFormat='Rs {0:N0}'}" HorizontalAlignment="Right" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Balance Due" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedSaleHistory.BalanceDue, StringFormat='Rs {0:N0}'}" HorizontalAlignment="Right" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="4" Margin="22,0,22,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding ReprintReceipt80mmCommand}" Content="80mm Print" Style="{StaticResource SecondaryButtonStyle}" Padding="12,10"/>
                        <Button Grid.Column="2" Command="{Binding PrintReceiptA4Command}" Content="A4 Print" Style="{StaticResource SecondaryButtonStyle}" Padding="12,10"/>
                        <Button Grid.Column="4" Command="{Binding CloseReceiptCommand}" Content="{DynamicResource Lang_Done}" Style="{StaticResource PrimaryButtonStyle}"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
