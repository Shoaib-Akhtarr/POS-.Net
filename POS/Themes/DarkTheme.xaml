<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Unified Dark Slate + Emerald Palette -->
    <SolidColorBrush x:Key="BgCanvasBrush" Color="#0B1120"/>
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="BgSubtleBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="BgMutedBrush" Color="#334155"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="#020617"/>
    <SolidColorBrush x:Key="BgSidebarHoverBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="BgSidebarActiveBrush" Color="#1E293B"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextSidebarBrush" Color="#94A3B8"/>

    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#334155"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1E293B"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="#14B8A6"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0D9488"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#0F766E"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#134E4A"/>
    <SolidColorBrush x:Key="PrimarySoftTextBrush" Color="#5EEAD4"/>

    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#450A0A"/>

    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#451A03"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#064E3B"/>

    <SolidColorBrush x:Key="ModalOverlayBrush" Color="#B3020617"/>

</ResourceDictionary>

