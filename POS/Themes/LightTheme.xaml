<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Unified Light Slate + Emerald Palette -->
    <SolidColorBrush x:Key="BgCanvasBrush" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgSubtleBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="BgMutedBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="BgSidebarHoverBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="BgSidebarActiveBrush" Color="#1E293B"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>
