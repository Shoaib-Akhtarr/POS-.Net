<Window x:Class="POS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:POS.ViewModels"
        xmlns:views="clr-namespace:POS.Views"
        xmlns:conv="clr-namespace:POS.Converters"
        mc:Ignorable="d"
        Title="Aizaz Fareed Center &amp; Al-Kuwait Electronics — POS"
        Height="820" Width="1366" MinHeight="680" MinWidth="1024"
        WindowState="Maximized"
        Background="{DynamicResource BgCanvasBrush}"
        Icon="Resources/icon.png"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSidebarBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,13"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgSidebarHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNavButtonActive" BasedOn="{StaticResource SidebarNavButton}" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgSidebarActiveBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="3,0,0,0" BorderBrush="{DynamicResource PrimaryBrush}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240">
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <Setter Property="Width" Value="72"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource BgSidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header & Collapse Toggle -->
                <Grid Grid.Row="0" Margin="14,18,14,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="{Binding ShopName}" Foreground="White" FontSize="13" FontWeight="Black" TextTrimming="CharacterEllipsis" MaxWidth="165"/>
                        <TextBlock Text="AL-KUWAIT ELECTRONICS" Foreground="{DynamicResource PrimaryBrush}" FontSize="9.5" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding ToggleSidebarCommand}" Background="Transparent" BorderThickness="0" Padding="8" Cursor="Hand" ToolTip="Toggle Sidebar">
                        <Path Data="{StaticResource Icon_Menu}" Fill="{DynamicResource TextSidebarBrush}" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- Navigation Items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Dashboard -->
                        <Button Command="{Binding NavigateToHomeCommand}" ToolTip="Dashboard (F1)">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.GetType().Name}" Value="HomeViewModel">
                                            <Setter Property="Background" Value="{DynamicResource BgSidebarActiveBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="3,0,0,0" BorderBrush="{DynamicResource PrimaryBrush}">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon_Dashboard}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Lang_Dashboard}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                            </StackPanel>
                        </Button>

                        <!-- New Sale / POS -->
                        <Button Command="{Binding NavigateToPOSCommand}" ToolTip="New Sale / POS (F2)">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.GetType().Name}" Value="POSViewModel">
                                            <Setter Property="Background" Value="{DynamicResource BgSidebarActiveBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="3,0,0,0" BorderBrush="{DynamicResource PrimaryBrush}">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon_POS}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Lang_NewSale}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                            </StackPanel>
                        </Button>

                        <!-- Inventory -->
                        <Button Command="{Binding NavigateToProductsCommand}" ToolTip="Inventory">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.GetType().Name}" Value="ProductsViewModel">
                                            <Setter Property="Background" Value="{DynamicResource BgSidebarActiveBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="3,0,0,0" BorderBrush="{DynamicResource PrimaryBrush}">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon_Inventory}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Lang_InventoryNav}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                            </StackPanel>
                        </Button>

                        <!-- Stock In / Purchases -->
                        <Button Command="{Binding NavigateToPurchasesCommand}" ToolTip="Stock In / Purchases">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.GetType().Name}" Value="PurchasesViewModel">
                                            <Setter Property="Background" Value="{DynamicResource BgSidebarActiveBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="3,0,0,0" BorderBrush="{DynamicResource PrimaryBrush}">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon_StockIn}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Lang_StockIn}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                            </StackPanel>
                        </Button>

                        <!-- Customers / Khata -->
                        <Button Command="{Binding NavigateToCustomersCommand}" ToolTip="Customers / Khata">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.GetType().Name}" Value="CustomersViewModel">
                                            <Setter Property="Background" Value="{DynamicResource BgSidebarActiveBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="3,0,0,0" BorderBrush="{DynamicResource PrimaryBrush}">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon_Customers}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Lang_Customers}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToKhataCommand}" ToolTip="Party Khata">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.GetType().Name}" Value="KhataViewModel">
                                            <Setter Property="Background" Value="{DynamicResource BgSidebarActiveBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon_Customers}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Party Khata" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToInstallmentsCommand}" ToolTip="Installments / Recovery">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.GetType().Name}" Value="InstallmentsViewModel">
                                            <Setter Property="Background" Value="{DynamicResource BgSidebarActiveBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon_Records}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Installments" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                            </StackPanel>
                        </Button>

                        <!-- Records -->
                        <Button Command="{Binding NavigateToRecordsCommand}" ToolTip="Records">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.GetType().Name}" Value="RecordsViewModel">
                                            <Setter Property="Background" Value="{DynamicResource BgSidebarActiveBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="3,0,0,0" BorderBrush="{DynamicResource PrimaryBrush}">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon_Records}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Lang_Records}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="#1E293B" Margin="16,12"/>

                        <!-- Settings / Profile -->
                        <Button Command="{Binding NavigateToProfileCommand}" ToolTip="Settings">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewModel.GetType().Name}" Value="ProfileViewModel">
                                            <Setter Property="Background" Value="{DynamicResource BgSidebarActiveBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="3,0,0,0" BorderBrush="{DynamicResource PrimaryBrush}">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon_Settings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Lang_Settings}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Active User / Switch User Footer -->
                <Border Grid.Row="2" Background="#020617" Padding="12,14" BorderThickness="0,1,0,0" BorderBrush="#1E293B">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource PrimaryBrush}">
                            <TextBlock Text="{Binding CurrentUserName, Converter={StaticResource InitialConv}}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="{Binding CurrentUserName}" Foreground="White" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentUserRole}" Foreground="{DynamicResource PrimaryBrush}" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>

                        <Button Grid.Column="2" Command="{Binding OpenSwitchUserCommand}" Background="Transparent" BorderThickness="0" Padding="6" Cursor="Hand" ToolTip="Switch User / Lock">
                            <Path Data="{StaticResource Icon_Lock}" Fill="{DynamicResource TextSidebarBrush}" Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Dynamic Content Area -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                    <views:HomeView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:POSViewModel}">
                    <views:POSView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
                    <views:ProductsView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:PurchasesViewModel}">
                    <views:PurchasesView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
                    <views:CustomersView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:KhataViewModel}">
                    <views:KhataView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:InstallmentsViewModel}">
                    <views:InstallmentsView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:RecordsViewModel}">
                    <views:RecordsView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                    <views:ProfileView/>
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>

        <!-- Staff PIN Login / Switch User Modal -->
        <Border x:Name="LoginOverlay" Grid.ColumnSpan="2" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsLoginModalOpen, Converter={StaticResource BoolToVis}}" IsVisibleChanged="LoginOverlay_IsVisibleChanged">
            <Border Style="{StaticResource SurfaceCardStyle}" Width="420" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource PrimarySoftBrush}" Margin="0,0,12,0">
                            <Path Data="{StaticResource Icon_Lock}" Fill="{DynamicResource PrimaryBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ShopName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                            <TextBlock Text="Select staff profile &amp; enter PIN" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="STAFF PROFILE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,18,0,6"/>
                    <ComboBox ItemsSource="{Binding StaffUsers}" SelectedItem="{Binding SelectedLoginUser}" Padding="10,8" FontSize="13">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Role, StringFormat=' ({0})'}" Foreground="#64748B"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="PIN (Default Owner: 1234 | Cashier: 0000)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,16,0,6"/>
                    <PasswordBox x:Name="LoginPinBox"
                                 Padding="12,10"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 Background="{DynamicResource BgSubtleBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderDefaultBrush}"
                                 BorderThickness="1"
                                 PasswordChanged="LoginPinBox_PasswordChanged"
                                 KeyDown="LoginPinBox_KeyDown"/>

                    <TextBlock Text="{Binding LoginError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0" Visibility="{Binding LoginError, Converter={StaticResource StrNotEmptyToVis}}"/>

                    <Button Command="{Binding SignInSelectedUserCommand}" Content="SIGN IN" Style="{StaticResource PrimaryButtonStyle}" Margin="0,18,0,10"/>
                    <Button Command="{Binding QuickCashierSignInCommand}" Content="Quick Start as Counter Cashier" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
